; Engine configuration file.
; 《打工》HUSTLE CITY —— Godot 4 工程配置
; 输入映射在 res://core/input_setup.gd 中用代码注册，便于阅读和修改。

config_version=5

[application]

config/name="打工 HUSTLE CITY"
config/description="第三人称 3D 赛博朋克都市人生模拟游戏"
config/version="1.12.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.03, 0.02, 0.07, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/events.gd"
DataDB="*res://autoload/data_db.gd"
SettingsManager="*res://autoload/settings_manager.gd"
GameManager="*res://autoload/game_manager.gd"
TimeManager="*res://autoload/time_manager.gd"
WeatherManager="*res://world/weather_manager.gd"
EconomyManager="*res://economy/economy_manager.gd"
SkillManager="*res://skills/skill_manager.gd"
PlayerManager="*res://player/player_manager.gd"
HousingManager="*res://housing/housing_manager.gd"
JobManager="*res://jobs/job_manager.gd"
NPCManager="*res://npc/npc_manager.gd"
QuestManager="*res://quests/quest_manager.gd"
EventManager="*res://events/event_manager.gd"
InvestmentManager="*res://investment/investment_manager.gd"
BusinessManager="*res://business/business_manager.gd"
TransportManager="*res://transport/transport_manager.gd"
VehicleManager="*res://transport/vehicle_manager.gd"
RomanceManager="*res://npc/romance_manager.gd"
GigManager="*res://jobs/gig_manager.gd"
AudioManager="*res://audio/audio_manager.gd"
SaveManager="*res://save/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/NotoSansSC-WL.ttf"
common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="interactable"
3d_physics/layer_5="trigger"
3d_physics/layer_6="prop"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.03, 0.02, 0.07, 1)
