          {"text": "她什么也不出。你们收拾东西离开鹭沼，别替任何人卖命。", "check": {"id": "offer_drive_intimidate", "skill": "intimidate", "dc": 15, "pass": "driven", "fail": "drive_fail"}},
          {"text": "（拔剑）那就没什么好谈的了。", "if": [{"quest_stage": "ch1_outlaws", "eq": "talk_offer"}], "do": [{"rep": "outlaws", "delta": -5}, {"fight": "camp", "win": "ch1_outlaws", "value": "beaten"}], "end": true},
