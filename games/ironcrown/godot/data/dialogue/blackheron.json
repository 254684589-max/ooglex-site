      "ledger_key": {
        "text": "（他的手按在腰上的钥匙串上）账房？没有家主的话，谁也别想进。……谁让你来要的，我心里有数。",
        "text_if": [{"if": [{"flag": "ledger_caught"}], "text": "（他看都不看你）撬窗的人，还有脸来要钥匙？"}, {"if": [{"flag": "counting_key_given"}], "text": "钥匙已经给你了。家主醒了，你自己跟他交代。"}],
        "options": [
          {"text": "家主醒的时候不多。他要问账，总不能等人去翻你的钥匙串——让我先替他把账拿出来。", "if": [{"not_flag": "counting_key_given"}, {"not_flag": "ledger_caught"}, {"not_flag": "herman_key_refused"}, {"not_flag": "ch1_ledger"}], "check": {"id": "herman_key", "skill": "speech", "dc": 15, "pass": "key_given", "fail": "key_no"}},
          {"text": "我家祖上替领主守过账房。钥匙交出去是什么分量，我知道——账拿出来，只给家主一个人看。", "if": [{"flag": "origin", "eq": "knight"}, {"not_flag": "counting_key_given"}, {"not_flag": "ledger_caught"}, {"not_flag": "herman_key_refused"}, {"not_flag": "ch1_ledger"}], "check": {"id": "herman_key_knight", "skill": "speech", "dc": 11, "pass": "key_given", "fail": "key_no"}},
          {"text": "维克托大人让我替他照看家主。瓦伦家的人信得过我。", "if": [{"not_flag": "counting_key_given"}, {"not_flag": "ledger_caught"}, {"not_flag": "herman_key_refused"}, {"not_flag": "ch1_ledger"}, {"rep": "valen", "at_least": 25}], "next": "key_trust"},
