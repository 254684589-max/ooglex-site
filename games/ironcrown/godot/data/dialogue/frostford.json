            "text": "保重。",
            "end": true
          }
        ]
      },
      "dawn": {
        "text": "（老霍布缩在酒馆门口睡着了，睡得正香。）",
        "options": [
          {
            "text": "（不吵醒他）",
            "end": true
          }
        ]
      },
      "dawn_hungry": {
        "text": "（老霍布缩在酒馆门口，听见脚步声睁开一只眼）……誓剑大人？有吃的吗？饿了一宿了。",
