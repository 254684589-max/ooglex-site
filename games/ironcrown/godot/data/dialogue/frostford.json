    "nodes": {
      "greet": {
        "text": "总算等到你了。少爷……埃德里克少爷天黑以后就没回来。老爷不想惊动全镇，让你悄悄把人找回来。",
        "options": [
          {
            "text": "我这就去找。",
            "next": "accept"
          },
          {
            "text": "少爷最近有什么不对劲吗？",
            "next": "odd"
          }
        ]
      },
      "odd": {
        "text": "他这几天常往酒馆跑，跟一个南方来的客人喝酒。老爷正打算给他说一门亲事，他……不太乐意。",
        "options": [
          {
            "text": "明白了，我这就去找。",
            "next": "accept"
          }
        ]
      },
      "accept": {
        "text": "多问问街上的人。更夫整夜都在巡街，酒馆门口那个醉鬼也什么都看得见——只要他还清醒。",
        "do": [
          {
            "quest": "edric_missing"
          },
          {
            "rep": "valen",
            "delta": 5
          }
        ],
        "options": [
          {
            "text": "放心。",
            "end": true
          }
        ]
      },
      "waiting": {
        "text": "有少爷的消息了吗？老爷一直坐在书房里等着。",
        "options": [
          {
            "text": "还在找，再给我点时间。",
            "end": true
          },
          {
            "text": "线索都指向渡口，我这就去。",
            "if": [
              {
                "quest_stage": "edric_missing",
                "eq": "to_ferry"
              }
            ],
            "next": "ferry"
          }
        ]
      },
      "ferry": {
        "text": "渡口……这种天气？快去吧。镇外桦林那条近路不太平，带上你的剑。",
        "options": [
          {
            "text": "知道了。",
            "end": true
          }
        ]
      },
      "thanks": {
        "text": "少爷回来了，一句话也没说，直接上了楼。老爷在书房里坐了很久……他说，天亮以后要亲自谢你。",
        "options": [
          {
            "text": "让他好好歇着吧。",
            "end": true
          }
        ]
      },
      "no_news": {
        "text": "渡口那边……有少爷的消息吗？老爷一夜没合眼，书房的灯到现在还亮着。",
        "options": [
          {
            "text": "（这件事，还是等天亮了再说）",
            "end": true
          }
        ]
      },
      "ch1": {
        "text": "老爷天没亮就在门口等你了。有什么话，跟他说吧。",
        "options": [
          {
            "text": "知道了。",
            "end": true
          }
        ]
      },
      "ch1_after": {
        "text": "路上小心。黑鹭堡的人说话都留着三分，你别全信。",
        "options": [
          {
            "text": "多谢。",
            "end": true
          }
        ]
      }
    }
  },
