          {"text": "滚。不然今晚渡口多几具尸体。",
            "check": {"id": "offer_intimidate", "skill": "intimidate", "dc": 15, "pass": "scared", "fail": "laugh"}},
          {"text": "（掂了掂钱袋）30 枚银币，够你们的人过冬。", "if": [{"silver": 30}], "do": [{"pay": 30}, {"set": "offer_paid"}], "next": "paid"},
          {"text": "那就动手吧。", "do": [{"fight": "ferry_offer", "win": "offer_defeated"}], "end": true},
