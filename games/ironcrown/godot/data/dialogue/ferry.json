    "nodes": {
      "greet": {
        "text": "（老修士提着一盏风灯，喘着气走下坡来）孩子……我放心不下埃德里克，一路跟了过来。他怎么样了？",
        "options": [
          {"text": "他跟我回去了。借据在我这儿，交给他父亲。", "if": [{"flag": "prologue_edric", "eq": "deliver"}], "next": "seal"},
          {"text": "他上船走了，借据他带走了。", "if": [{"flag": "prologue_edric", "eq": "release"}], "next": "seal"},
          {"text": "他自己回镇上了。借据在我手里。", "if": [{"flag": "prologue_edric", "eq": "extort"}], "next": "seal"}
        ]
      },
      "seal": {
        "text": "（他听你说起借据背面那枚印，手里的灯晃了一下）一顶星铁冠？……那是王室的印鉴。老王生前亲手担保过这笔债——难怪卡斯韦尔家这么急着要它。",
        "options": [
          {"text": "这意味着什么？", "next": "book"}
        ]
      },
      "book": {
        "text": "（他从怀里摸出一本封皮烧焦了一角的旧书，塞进你手里）我说不清，也不敢说。去黑鹭堡，别让任何人看见。",
        "do": [{"give_item": "old_book"}, {"set": "prologue_done"}, {"quest_done": "edric_missing"}, {"ending": "prologue"}],
        "options": [
          {"text": "（收下旧书）", "end": true}
        ]
      },
      "farewell": {
        "text": "去黑鹭堡吧，孩子。那本书，收好。",
        "options": [
          {"text": "（点点头）", "end": true}
        ]
      }
    }
  },
  "silas": {
