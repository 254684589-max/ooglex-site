    "nodes": {
      "greet": {
        "text": "（一个比你高出半个头的大个子靠在吧台边，斜着眼看你）看什么看？要请我喝一杯，就坐下；不请，就站远点。",
        "options": [
          {"text": "玛蒂尔达说你欠了三个晚上的酒钱。", "if": [{"flag": "matilda_brawl_offer"}], "next": "challenge"},
          {"text": "你是做什么的？", "next": "who"},
          {"text": "打扰了。", "end": true}
        ]
      },
      "who": {
        "text": "渡口扛包的。一包盐二十斤，我一趟扛四包。……现在？雾这么大，船不开，没包可扛，只能喝。",
        "options": [
          {"text": "玛蒂尔达说你欠了三个晚上的酒钱。", "if": [{"flag": "matilda_brawl_offer"}], "next": "challenge"},
          {"text": "不打扰你喝了。", "end": true}
        ]
      },
      "challenge": {
        "text": "（他把杯子往吧台上一墩，站直了身子）酒钱？想让我掏钱，先把我放倒。说好了，不许动刀子——在酒馆里动刀子的，算不上汉子。",
        "options": [
          {"text": "那就来吧。（徒手打一架）", "do": [{"brawl": "drunk", "win": "dagu_beaten", "lose": "dagu_won"}], "end": true},
          {"text": "算了。", "end": true}
        ]
      },
      "won": {
        "text": "（他哈哈大笑，又灌了一口酒）还站得起来？还想再挨一顿？",
        "options": [
          {"text": "再来一场。（徒手打一架）", "if": [{"flag": "matilda_brawl_offer"}], "do": [{"brawl": "drunk", "win": "dagu_beaten", "lose": "dagu_won"}], "end": true},
          {"text": "改天。", "end": true}
        ]
      },
      "beaten": {
        "text": "（他揉着下巴，把几枚银币拍在吧台上）结了，结了！……你这拳头，渡口扛包的都比不上。",
        "options": [
          {"text": "以后少喝点。", "end": true}
        ]
      }
    }
  },
