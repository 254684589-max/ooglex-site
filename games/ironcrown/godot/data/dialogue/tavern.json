        "do": [{"set": "matilda_refused"}],
        "options": [
          {"text": "（把 5 枚银币推过去）那这样呢？", "if": [{"silver": 5}], "do": [{"pay": 5}, {"set": "matilda_paid"}], "next": "edric_told"},
          {"text": "（朝吧台那头的大个子扬了扬下巴）那个人，是不是给你添了麻烦？", "if": [{"not_flag": "matilda_brawl_offer"}], "next": "dagu_offer"},
