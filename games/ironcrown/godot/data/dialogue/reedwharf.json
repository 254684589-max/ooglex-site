      },
      "beacon": {
        "text": "守了十一年。第三座烽燧，去年冬天熄的：没有柴，没有人，没有援兵，我们自己从山上撤下来的。……所以别跟我提王都。",
        "options": [
          {"text": "……", "next": "menu"}
        ]
      },
      "menu": {
        "text": "还想听什么？",
        "options": [
          {"text": "那就说说实话。", "next": "truth"},
          {"text": "长桌那边说，跟着长子有王都的粮吃。", "next": "grain"},
          {"text": "你在烽燧上守过？", "next": "beacon"},
          {"text": "堡门不让我进。", "if": [{"not_flag": "ch1_letter"}, {"not_flag": "castle_admitted"}], "next": "side_gate"},
          {"text": "（走开）", "end": true}
        ]
      }
    }
