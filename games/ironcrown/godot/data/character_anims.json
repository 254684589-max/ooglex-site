  "locomotion": {
    "note": "ref_speed = 动作本身一个周期走过的距离 ÷ 时长（米 / 秒，从 UAL1_Standard_RM 的根骨骼位移量出）；播放速度 = 实际移动速度 ÷ ref_speed，夹在 [scale_min, scale_max]。低于 stop_below 算站着；高于 run_from 换成跑步动作。",
    "stop_below": 0.3,
    "run_from": 2.0,
    "walk": {"ref_speed": 0.97, "scale_min": 0.6, "scale_max": 1.8},
    "run": {"ref_speed": 5.36, "scale_min": 0.5, "scale_max": 1.3},
    "crouch_move": {"ref_speed": 0.75, "scale_min": 0.6, "scale_max": 1.8}
  },
  "attacks": {
    "note": "出招动作与近战判定对齐：impact = 动作里剑最靠前、速度最快的时刻（从每帧右手位置量出）。播放速度 = (impact − 起点) ÷ 近战从起点到命中帧的时间（combat/melee.gd TIMING）。heavy 先蓄力：按住时把动作从 0 推到 wind_peak（抬到最高）停住，松手后从 wind_peak 打到 impact。",
    "light": [
      {"clip": "Sword_Regular_A", "impact": 0.23},
      {"clip": "Sword_Regular_B", "impact": 0.23},
      {"clip": "Sword_Regular_C", "impact": 0.66, "from": 0.45}
    ],
    "heavy": {"clip": "Sword_Attack", "wind_peak": 0.33, "impact": 0.40},
    "dash": {"clip": "Sword_Dash", "impact": 0.32},
    "recover": {"Sword_Regular_A": "Sword_Regular_A_Rec", "Sword_Regular_B": "Sword_Regular_B_Rec", "speed": 2.0},
    "a1b_note": "A.1b（tools/measure_clips.gd 量的）：第三段 Sword_Regular_C 从头顶劈下，前面 0.45 秒是举剑的准备、跳过（from）；冲刺突刺 Sword_Dash 第 0.32 秒刺到最前；轻击收招播对应的 _Rec 动作（2 倍速，接回持剑待机）。"
  },
  "dodge": {"note": "闪避（A.1b）：Roll 前 0.35 秒是下蹲起跳、1.25 秒以后是站直，只播中间这段，按 Melee.DODGE_TIME 调速；往身后闪倒着播。", "from": 0.35, "to": 1.25},
  "land": {"note": "落地（A.1b）：从高处落下（腾空超过 min_air 秒）、落地时没在走动，播 Jump_Land 前 0.72 秒（膝盖弯下去再站起来）。", "min_air": 0.45, "speed": 1.6, "time": 0.45},
  "block": {"hold": 0.17},
  "fists": {
    "note": "徒手（3.3）。举拳待机停在 Punch_Jab 第 0 帧（双拳护脸的架势，idle_at）；轻拳一刺拳（左手）、二直拳（右手）；重拳是 Melee_Hook（右手勾拳，A.1b 换掉了借用的 OverhandThrow）；空手格挡停在 Idle_Shield_Loop 第 0 帧（小臂横在胸前，block_at）。impact = 出拳那只手最靠前、最快的时刻（逐帧量手骨的位置）；播放速度的算法和持剑一样（见 attacks）。",
    "idle_at": 0.0,
    "block_at": 0.0,
    "light": [
      {"clip": "Punch_Jab", "impact": 0.19},
      {"clip": "Punch_Cross", "impact": 0.27}
    ],
    "heavy": {"clip": "Melee_Hook", "wind_peak": 0.22, "impact": 0.27}
  },
  "grip": {
    "note": "剑挂在 hand_r 骨骼上的位置与朝向（米 / 度），用截图校准：剑身沿手骨的 +Z（拇指一侧）再向手指方向（+Y）偏 45°（偏小时待机像把剑举向一侧，偏大时格挡像横着指向旁边，45° 折中），剑面法线朝手心（-X）；位置在手掌中心。",
