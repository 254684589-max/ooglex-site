; Engine configuration file.
; 《铁冠之争》THE IRON CROWN —— Godot 4 工程配置（阶段 1：灰盒）

config_version=5

[application]

config/name="铁冠之争 THE IRON CROWN"
config/description="原创第一人称中世纪权谋角色扮演游戏（开发中）"
config/version="0.0.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.06, 0.09, 0.13, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

UiScale="*res://core/ui_scale.gd"
InputSetup="*res://core/input_setup.gd"
Settings="*res://core/settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"
window/handheld/orientation=6

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[gui]

theme/custom_font="res://assets/fonts/NotoSansSC-IC.ttf"

[input_devices]

pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="世界"
3d_physics/layer_2="玩家"
3d_physics/layer_3="可交互"
