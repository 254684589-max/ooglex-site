; Engine configuration file.
; 《工地搬砖》BRICK BY BRICK —— Godot 4 工程配置
; 输入映射在 res://scripts/core/input_setup.gd 中用代码注册，便于阅读和修改。

config_version=5

[application]

config/name="工地搬砖 BRICK BY BRICK"
config/description="第三人称 3D 工地模拟 / 打工 / 生存 / 成长游戏"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.086, 0.086, 0.098, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Events="*res://scripts/systems/events.gd"
GameState="*res://scripts/systems/game_state.gd"
EconomySystem="*res://scripts/systems/economy_system.gd"
TimeSystem="*res://scripts/systems/time_system.gd"
PlayerStats="*res://scripts/systems/player_stats.gd"
TaskSystem="*res://scripts/systems/task_system.gd"
SaveSystem="*res://scripts/systems/save_system.gd"
Sfx="*res://scripts/systems/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/NotoSansSC-CW.ttf"
common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="interactable"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.52, 0.66, 0.8, 1)
